# ──────────────────────────────────────────────────
# HyperTrack — Variables de Entorno de Ejemplo
# Copia este archivo como .env.local y ajusta tus credenciales
# ──────────────────────────────────────────────────

# Cadena de conexión a MongoDB (Local o MongoDB Atlas)
# IMPORTANTE: Respetar mayúsculas y minúsculas en el nombre de la BD ('HyperTrackb')
MONGODB_URI=mongodb://localhost:27017/HyperTrackb
MONGODB_DB=HyperTrackb

# Secreto criptográfico para firma y verificación de tokens JWT (HS256)
AUTH_SECRET=super_secret_jwt_key_min_32_characters_random_string

# Factor de costo de hashing para Bcrypt / Argon2
BCRYPT_SALT_ROUNDS=12
